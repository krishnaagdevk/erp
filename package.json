{
  "name": "lama-dev-next-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "cap:run:usb": "adb reverse tcp:3000 tcp:3000 && adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.schoollama.erp/com.schoollama.erp.MainActivity",
    "cap:build": "cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:build:unix": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.22.0",
    "@types/react-big-calendar": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.11",
    "moment": "^2.30.1",
    "next": "^16.3.4",
    "next-cloudinary": "^6.18.8",
    "prisma": "^5.22.0",
    "react": "^19.2.3",
    "react-big-calendar": "^1.20.0",
    "react-calendar": "^5.1.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.54.2",
    "react-toastify": "^10.0.6",
    "recharts": "^2.15.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/next": "^9.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
