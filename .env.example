# ==============================================================================
# Full-Stack School Management System - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL + Prisma)
# ------------------------------------------------------------------------------
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL="mysql://erp_user:erp_password@localhost:3306/school_erp"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (JWT Secret - minimum 32 characters)
# ------------------------------------------------------------------------------
JWT_SECRET="generate_a_secure_random_32_character_secret_key_here"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (Avatars & Image Uploads)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 MULTI-ACCOUNT STORAGE (PDFs, Homework, Invoices & Files)
# ------------------------------------------------------------------------------
# OPTION A: Single Default R2 Account
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# OPTION B: Multiple Free-Tier Accounts (Indexed R2_ACC_1_*, R2_ACC_2_*, etc.)
# Add as many accounts as you want; uploads will automatically load-balance across them:
# R2_ACC_1_ACCOUNT_ID=account_1_id
# R2_ACC_1_ACCESS_KEY_ID=account_1_access_key
# R2_ACC_1_SECRET_ACCESS_KEY=account_1_secret_key
# R2_ACC_1_BUCKET_NAME=account_1_bucket
# R2_ACC_1_PUBLIC_URL=https://pub-acc1.r2.dev

# R2_ACC_2_ACCOUNT_ID=account_2_id
# R2_ACC_2_ACCESS_KEY_ID=account_2_access_key
# R2_ACC_2_SECRET_ACCESS_KEY=account_2_secret_key
# R2_ACC_2_BUCKET_NAME=account_2_bucket
# R2_ACC_2_PUBLIC_URL=https://pub-acc2.r2.dev

# OPTION C: Raw JSON Array for infinite accounts
# R2_ACCOUNTS_JSON='[{"id":"tier1","accountId":"...","accessKeyId":"...","secretAccessKey":"...","bucketName":"...","publicUrl":"..."}]'

